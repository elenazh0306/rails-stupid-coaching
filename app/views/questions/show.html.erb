<div class="d-block">
  <div class="chat">
    <h1>Chat with Stupid Coaching</h1>
    <div class="question chat-bubble">
      <p><%= @question.content %></p>
    </div>
    <div class="answer chat-bubble">
      <p><%= @question.answer %></p>
    </div>
  </div>
  <%= link_to 'Ask a new question', new_question_path  %>
  <%= link_to "History", questions_path %>
</div>
